# Copy this file to .env (repo root) and fill in your release signing values.
# .env is git-ignored; never commit it.
#
# Required:
KEYSTORE_FILE=/absolute/path/to/your-release.jks
KEYSTORE_PASSWORD=change-me
KEY_ALIAS=change-me

# Optional. Defaults to KEYSTORE_PASSWORD.
# KEY_PASSWORD=

# Optional build selection.
# FLAVOR=full
# WITH_WEAR=1
